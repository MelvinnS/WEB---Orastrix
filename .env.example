# Database Connection String dari Neon Postgres (https://neon.tech)
DATABASE_URL="postgres://user:password@ep-cool-name.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Password untuk Login Admin di Halaman /admin
ADMIN_PASSWORD="ganti_dengan_password_admin_rahasia_kamu"

# Rahasia untuk Menandatangani Cookie Sesi Admin (Min 32 karakter)
SESSION_SECRET="ganti_dengan_kunci_sesi_rahasia_minimal_32_karakter_random_123"

# Salt Rahasia untuk Hashing IP Alamat Pengirim Review (SHA-256)
IP_HASH_SALT="ganti_dengan_ip_hash_salt_rahasia_random_99"

# Formspree Form ID untuk formulir Contact Us (https://formspree.io)
# Dapatkan Form ID dari dashboard Formspree kamu (contoh: "xyyzzabc" dari https://formspree.io/f/xyyzzabc)
VITE_FORMSPREE_ID="ganti_dengan_formspree_form_id_kamu"
